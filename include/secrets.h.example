#pragma once
// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h is intentionally excluded from git so credentials never get committed.

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ---- xiaozhi backend (see https://github.com/78/xiaozhi-esp32) ----
// Defaults point at the free official cloud (xiaozhi.me). On first boot the
// device POSTs to XIAOZHI_OTA_URL and shows a 6-digit activation code on the
// LCD — enter it in the xiaozhi.me console to bind the device to your account.
// To use a self-hosted server (e.g. xinnan-tech/xiaozhi-esp32-server), point
// both URLs at it instead.
#define XIAOZHI_OTA_URL  "https://api.tenclass.net/xiaozhi/ota/"
#define XIAOZHI_WS_URL   "wss://api.tenclass.net/xiaozhi/v1/"
#define XIAOZHI_WS_TOKEN "test-token"
