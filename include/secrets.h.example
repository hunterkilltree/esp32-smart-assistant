#pragma once
// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h is intentionally excluded from git so credentials never get committed.

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ---- AI engine ----
// The device streams mic audio straight to the chosen provider's realtime
// voice API over WebSocket and plays the spoken reply back. Pick one:
//   AI_ENGINE_GEMINI — Gemini Live API. Free-tier key at
//                      https://aistudio.google.com/apikey
//   AI_ENGINE_OPENAI — OpenAI Realtime API (paid). Key at
//                      https://platform.openai.com/api-keys
// Only the selected engine's key needs to be real.
#define AI_ENGINE       AI_ENGINE_GEMINI

#define GEMINI_API_KEY  "your-gemini-api-key"
#define OPENAI_API_KEY  "your-openai-api-key"

